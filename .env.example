# ------------------------------------------------------------------------------
# Ciclo Azul — variaveis de ambiente do ambiente de desenvolvimento (Docker Compose)
#
# Copie este arquivo para .env e ajuste conforme necessario:
#     cp .env.example .env
#
# NUNCA comite o .env (ele esta no .gitignore). Apenas este .env.example e versionado.
# Os valores abaixo sao adequados APENAS para desenvolvimento local.
# ------------------------------------------------------------------------------

# --- Banco de dados da aplicacao (PostgreSQL) ---
POSTGRES_DB=ciclo_azul
POSTGRES_USER=ciclo_azul
POSTGRES_PASSWORD=ciclo_azul_dev
POSTGRES_PORT=5432

# --- Banco de dados do Keycloak (PostgreSQL separado) ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev

# --- Keycloak (admin do console) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HTTP_PORT=8080

# --- Broker MQTT (Mosquitto) ---
MQTT_PORT=1883
MQTT_WS_PORT=9001

# --- Mock de sensores (servico opcional, profile "mock") ---
# Host do broker visto de dentro da rede do compose.
MQTT_BROKER=mqtt
# Unidade simulada publicada pelo mock.
MOCK_UNIT_ID=data-center-sp-01
