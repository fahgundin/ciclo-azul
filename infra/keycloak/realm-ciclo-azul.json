{
  "realm": "ciclo-azul",
  "enabled": true,
  "displayName": "Ciclo Azul",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "administrador", "description": "Administrador: configuracao e acesso ao sistema" },
      { "name": "gestor-ambiental", "description": "Gestor Ambiental: conformidade e destinacao de agua/residuos" },
      { "name": "operador", "description": "Operador: infraestrutura do data center (refrigeracao/facilities)" },
      { "name": "diretoria", "description": "Diretoria: resultados e prestacao de contas" }
    ]
  },
  "clients": [
    {
      "clientId": "ciclo-azul-web",
      "name": "Ciclo Azul Web (PWA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-ciclo-azul-web",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ciclo-azul-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "gestor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Gestor",
      "lastName": "Ambiental",
      "email": "gestor@ciclo-azul.dev",
      "credentials": [
        { "type": "password", "value": "gestor", "temporary": false }
      ],
      "realmRoles": ["gestor-ambiental"]
    }
  ]
}
